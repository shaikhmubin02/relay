# Relay configuration.
#
# Copy to .env and edit. Every default below is safe: with no changes at all,
# Relay runs end to end with no credentials, no network calls, and no messages
# leaving the machine.
#
# NEVER commit a filled-in .env. NEVER put a real secret in this file.

# ---------------------------------------------------------------------------
# Planner
# ---------------------------------------------------------------------------
# auto    - use Claude on Bedrock when credentials resolve, else the offline planner
# bedrock - require Bedrock; fail loudly rather than silently simulate
# offline - never call a network model (used by tests and the evaluation)
RELAY_MODEL_PROVIDER=auto

# Bedrock inference profile id, "<prefix>.anthropic.<model>".
# Run `python -m relay check-model --list` to see what your account can reach.
RELAY_MODEL_ID=global.anthropic.claude-opus-5
AWS_REGION=us-west-2
# AWS credentials are resolved by boto3 in the usual way (profile, env, role).
# Do not put AWS keys in this file.

# ---------------------------------------------------------------------------
# Outbound messages
# ---------------------------------------------------------------------------
# fake - captured in Relay's built-in test inbox; nothing is sent
# smtp - real delivery through the relay configured below
RELAY_EMAIL_TRANSPORT=fake
RELAY_EMAIL_FROM=relay@relay.test

# Hard limit on who Relay may ever message. Checked when a message is queued and
# again when it is sent. Keep this to test domains for anything demo-related.
RELAY_EMAIL_ALLOWLIST_DOMAINS=relay.test

# Only used when RELAY_EMAIL_TRANSPORT=smtp.
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_USER=
RELAY_SMTP_PASSWORD=
RELAY_SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs the single-use links volunteers click. Changing it invalidates every
# outstanding link. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_TOKEN_SECRET=dev-only-insecure-secret

# Coordinator sign-in. Separate from the intake token on purpose: a compromised
# webhook credential must not grant access to the coordinator's screens.
RELAY_COORDINATOR_TOKEN=dev-coordinator-token
RELAY_INTAKE_TOKEN=dev-intake-token

# Used to build the links inside outgoing messages.
RELAY_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Limits and worker
# ---------------------------------------------------------------------------
# Per-workflow hard ceilings. A runaway loop stops here rather than at the bill.
RELAY_MAX_MODEL_CALLS=8
RELAY_MAX_TOOL_CALLS=24
RELAY_MAX_EMAILS=6

RELAY_WORKER_ENABLED=true
RELAY_WORKER_INTERVAL_SECONDS=5

# Where the SQLite database lives.
RELAY_DB=var/relay.db
